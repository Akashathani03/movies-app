# Copy this file to .env.local and replace the placeholders with your own values.
# Never commit real values. Note: every VITE_* value is embedded in the browser bundle.

# TMDB API Read Access Token (v4 "Bearer" token, not the v3 API key)
VITE_TMDB_API_KEY=your_tmdb_api_read_access_token

# Appwrite Cloud project, database and collection used for search tracking
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id
VITE_APPWRITE_DATABASE_ID=your_appwrite_database_id
VITE_APPWRITE_COLLECTION_ID=your_appwrite_collection_id
